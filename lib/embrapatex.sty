% Determina o tipo do trabalho apresentado
% Tipos de documento da Embrapa:
%   relatorio    - Relatório Técnico / Relatório Final
%   boletim      - Boletim de Pesquisa e Desenvolvimento
%   comunicado   - Comunicado Técnico
%   documento    - Documento (genérico)

% Definicao das variaveis
\provideboolean{embrapatex@ehrelatorio}
\provideboolean{embrapatex@ehboletim}
\provideboolean{embrapatex@ehcomunicado}
\provideboolean{embrapatex@ehdocumento}

% Valores Iniciais
\setboolean{embrapatex@ehrelatorio}{true}
\setboolean{embrapatex@ehboletim}{false}
\setboolean{embrapatex@ehcomunicado}{false}
\setboolean{embrapatex@ehdocumento}{false}

\newcommand{\tipodocumento}[1]{
	\setboolean{embrapatex@ehrelatorio}{false}
	\setboolean{embrapatex@ehboletim}{false}
	\setboolean{embrapatex@ehcomunicado}{false}
	\setboolean{embrapatex@ehdocumento}{false}

	\ifthenelse{\equal{#1}{relatorio}}{%
		\setboolean{embrapatex@ehrelatorio}{true}
	}{
		\ifthenelse{\equal{#1}{boletim}}{%
			\setboolean{embrapatex@ehboletim}{true}
		}{
			\ifthenelse{\equal{#1}{comunicado}}{%
				\setboolean{embrapatex@ehcomunicado}{true}
			}{
				\ifthenelse{\equal{#1}{documento}}{%
					\setboolean{embrapatex@ehdocumento}{true}
				}{
					\setboolean{embrapatex@ehrelatorio}{true}
				}
			}
		}
	}
}

% Mantém compatibilidade - apelido para o comando antigo
\newcommand{\trabalhoacademico}[1]{\tipodocumento{#1}}

