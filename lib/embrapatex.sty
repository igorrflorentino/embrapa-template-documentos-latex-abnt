		\vspace{\onelineskip}
		\vspace{\onelineskip}
		\MakeUppercase{\imprimirtitulo}
	\end{center}

	\vspace{\onelineskip}
	\vspace{\onelineskip}

	%Retira o espaço do parágrafo
	\noindent\hspace*{-2cm}
	%Adiciona o espaço da margem
	\hspace*{8cm}
	\begin{minipage}{8cm}
		\begin{SingleSpace}
			\sloppy
			\imprimirpreambulo
		\end{SingleSpace}
	\end{minipage}\hfill

	\vspace{\onelineskip}

	\noindent Aprovada em: \imprimirdataaprovacao

	\vspace{\onelineskip}

	\begin{center}
		BANCA EXAMINADORA / REVISORES
	\end{center}
		\vspace{\onelineskip}

	% Membro Um da banca é sempre o Orientador
	\ifnotempty{\imprimirorientadorcentro}{
		\assinatura{\imprimirorientador\  \artigoorientadorcomparenteses \\ \imprimirorientadorcentro \\  \imprimirorientadories}
	}{
		\assinatura{\imprimirorientador\  \artigoorientadorcomparenteses \\  \imprimirorientadories}
	}

	% Membro Dois da banca pode ser o coorientador ou outro membro
	\ifnotempty{\imprimircoorientador}{
		\assinatura{\imprimircoorientador\ \artigocoorientadorcomparenteses \\ \imprimircoorientadorcentro\\ \imprimircoorientadories}
	}

	% Membro Três da banca pode ser o coorientador ou outro membro
	\ifnotempty{\imprimirmembrodabancadois}{
		\assinatura{\imprimirmembrodabancadois \\ \imprimirmembrodabancadoiscentro \\ \imprimirmembrodabancadoisies}
	}

	% Membro Quatro
	\ifnotempty{\imprimirmembrodabancatres}{
		\assinatura{\imprimirmembrodabancatres \\ \imprimirmembrodabancatrescentro \\ \imprimirmembrodabancatresies}
	}

	% Membro Cinco
	\ifnotempty{\imprimirmembrodabancaquatro}{
		\assinatura{\imprimirmembrodabancaquatro \\ \imprimirmembrodabancaquatrocentro \\ \imprimirmembrodabancaquatroies}
	}

	\pagebreak
}

