%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%          Ficha Catalografica        %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Gera a ficha catalográfica em LaTeX a partir dos metadados do documento.
% Não recebe argumentos: os dados são lidos dos campos definidos no main.tex
% (autor, título, local, data, \cdd, \descritores, \bibliotecario etc.).
% A caixa segue o padrão ABNT (~7,5 x 12,5 cm) e é posicionada na parte
% inferior da página. Campos vazios são omitidos automaticamente.
\newcommand{\imprimirfichacatalografica}{%
	\ifthenelse{\boolean{embrapatex@ehqualificacao}}{}{%
		\clearpage
		\thispagestyle{empty}%
		\vspace*{\fill}%
		\begin{center}%
			\setlength{\fboxsep}{0.4cm}%
			\fbox{%
				\begin{minipage}[c][6.5cm][t]{11.5cm}%
					\small
					\setlength{\parindent}{0pt}%
					\setlength{\parskip}{0pt}%
					\sloppy
					% Entrada principal: autor invertido (Sobrenome, Nome).
					% Se \autorinvertido estiver vazio, usa-se \autor.
					\ifnotempty{\imprimirautorinvertido}{\imprimirautorinvertido}{\imprimirautor}\par
					% Corpo da ficha com recuo pendente de 0,9 cm
					\begingroup
						\setlength{\leftskip}{0.9cm}%
						\imprimirtitulo\ifnotempty{\imprimirautor}{\ / \imprimirautor}{}.%
							\ifnotempty{\imprimiredicao}{\ -- \imprimiredicao}{}%
							\ -- \imprimirlocal\ : \imprimireditora, \imprimirdata.\par
						\ifnotempty{\imprimirnumeropaginas}{%
							\imprimirnumeropaginas\ p.%
							\ifnotempty{\imprimirilustracao}{\ : \imprimirilustracao}{}%
							\ifnotempty{\imprimirdimensao}{\ ; \imprimirdimensao}{}.\par}{}%
						\vspace{4pt}%
						\ifnotempty{\imprimirisbn}{ISBN \imprimirisbn.\par}{}%
						\ifnotempty{\imprimirnotaficha}{\imprimirnotaficha\par}{}%
						\ifthenelse{\equal{\imprimirincluibibliografia}{sim}}{Inclui bibliografia.\par}{}%
						\ifnotempty{\imprimirdescritores}{\vspace{4pt}\imprimirdescritores\par}{}%
					\endgroup
					\vspace{4pt}%
					\ifnotempty{\imprimircdd}{{\raggedleft CDD: \imprimircdd\par}}{}%
					\ifnotempty{\imprimircdu}{{\raggedleft CDU: \imprimircdu\par}}{}%
					\vfill
					\ifnotempty{\imprimirbibliotecario}{%
						{\centering\footnotesize
							\imprimirbibliotecario\ifnotempty{\imprimircrb}{\ -- \imprimircrb}{}\par}}{}%
				\end{minipage}%
			}%
		\end{center}%
		\vspace*{\fill}%
		\clearpage
	}%
}

